{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "EDS — Editorial Design System. Extracted from dsh-theme-endfield (src/styles/theme.css + src/client/41-mount-tokens.js). Source of truth for the CSS is design/tokens.css; this file is the import format for tooling (Figma, Style Dictionary, Tailwind config). Every `contrast` annotation is recomputed by design/scripts/check-contrast.mjs.",

  "surface": {
    "base": { "$value": { "light": "#e8e8e2", "dark": "#101110" }, "$type": "color", "$description": "纸底 / 墨底：应用背景、侧栏。不是纯白、不是纯黑。" },
    "raised": { "$value": { "light": "#f2f2ec", "dark": "#181a18" }, "$type": "color", "$description": "面板、气泡、输入框。对比度门槛按此表面验算。" },
    "sunken": { "$value": { "light": "#dcddd6", "dark": "#1e201d" }, "$type": "color", "$description": "沉底块：表头、骨架、凹槽。" },
    "overlay": { "$value": { "light": "#f2f2ec", "dark": "#1c1e1c" }, "$type": "color", "$description": "菜单与弹层。刻意不透明——半透明菜单压在背景上会读成「没有背景」。" },
    "selector": { "$value": { "light": "#e8e8e2", "dark": "#2c2e2a" }, "$type": "color", "$description": "分段控件轨道。" },
    "code": { "$value": { "light": "#ecece6", "dark": "#181a18" }, "$type": "color", "$description": "代码块。" }
  },

  "line": {
    "hairline": { "$value": { "light": "#d8d9d5", "dark": "#343633" }, "$type": "color", "$description": "行分隔、卡片描边。纸面上唯一的结构词汇。" },
    "strong": { "$value": { "light": "#b6b8b3", "dark": "#4a4d49" }, "$type": "color", "$description": "按钮描边、强调分隔线。" },
    "contrast": { "$value": { "light": "#9a9d98", "dark": "#5f6460" }, "$type": "color", "$description": "需要穿过淡层仍然可见的分隔线。" }
  },

  "text": {
    "primary": { "$value": { "light": "#101110", "dark": "#f5f5f0" }, "$type": "color", "$description": "正文。15.38:1 纸底 / 16.84:1 面板（亮），17.30 / 16.00（暗）。" },
    "secondary": { "$value": { "light": "#4a4c48", "dark": "#898d89" }, "$type": "color", "$description": "次要文字。7.06 / 7.73（亮），5.62 / 5.20（暗）。" },
    "tertiary": { "$value": { "light": "#6a6d68", "dark": "#9a9d98" }, "$type": "color", "$description": "辅助说明。4.27 / 4.67（亮），6.89 / 6.38（暗）。" },
    "caption": { "$value": { "light": "#5a5d58", "dark": "#a4a6a1" }, "$type": "color", "$description": "小字、脚注。5.43 / 5.95（亮），7.70 / 7.12（暗）。" },
    "dimmed": { "$value": { "light": "#9a9d98", "dark": "#70736f" }, "$type": "color", "$description": "非文字部件专用。2.23:1（亮）/ 3.94:1（暗）——绝不可用于正文。" },
    "inverse": { "$value": { "light": "#f5f5f0", "dark": "#101110" }, "$type": "color", "$description": "压在墨色 / 深色实心上的文字。" },
    "onAccent": { "$value": "#101110", "$type": "color", "$description": "压在强调实心上的文字。永远是墨色，永不用白。16.50:1（谷地黄）/ 9.88:1（武陵青）。" },
    "onSelection": { "$value": "#000000", "$type": "color", "$description": "文本选中：比芯片墨色更硬一档，与悬停淡层拉开区分。" }
  },

  "status": {
    "error": { "$value": { "light": "#ff3b30", "dark": "#ff6b61" }, "$type": "color", "$description": "错误填充 / 圆点 / 图标。不参与配色切换。" },
    "errorText": { "$value": { "light": "#c62016", "dark": "#ff6b61" }, "$type": "color", "$description": "错误作为小字文字时单独取档：4.72:1 / 5.16:1（亮）。原始 #ff3b30 只有 2.88:1，不可用于文字。" },
    "success": { "$value": { "light": "#2f9e44", "dark": "#4fbf5c" }, "$type": "color" },
    "warn": { "$value": { "light": "#d9822b", "dark": "#ffb700" }, "$type": "color" }
  },

  "accent": {
    "$description": "同一支色相，按表面不同分为三种取值：实心底、悬停底、以及「作为文字」的明暗两档。亮色下强调色作为文字必须下沉——#fff500 在纸面上只有 1.07:1，不是配色选择，是一次抹除。",
    "signal": {
      "$description": "谷地黄 · 默认配色 · 终末地官网的信号黄",
      "base": { "$value": "#fff500", "$type": "color", "$description": "实心底、图标、焦点环。相对亮度 86.6%。" },
      "rgb": { "$value": "255, 245, 0", "$type": "string", "$description": "同色的通道列表，供 rgba() 使用。与 hex 并列声明，两者不会漂移。" },
      "hover": { "$value": "#e8e000", "$type": "color", "$description": "悬停 / 按下。墨色字 13.60:1。" },
      "onLight": { "$value": "#d9c700", "$type": "color", "$description": "唯一必须作为「填充」留在奶油纸上的槽位。墨色字 10.92:1。" },
      "textLight": { "$value": "#6b5d00", "$type": "color", "$description": "亮色模式下强调色作为文字。5.35:1 纸底 / 5.86:1 面板。" },
      "textLightSoft": { "$value": "#3f3600", "$type": "color", "$description": "亮色模式流光亮带。9.82 / 10.75。" },
      "textDark": { "$value": "#fff500", "$type": "color", "$description": "暗色模式强调文字。16.50 / 15.26。" },
      "textDarkSoft": { "$value": "#a08a00", "$type": "color", "$description": "暗色模式亮带：黄色向上已到顶，只能压暗。5.52 / 5.11。" },
      "glowLight": { "$value": 0.08, "$type": "number" },
      "glowDark": { "$value": 0.05, "$type": "number" }
    },
    "teal": {
      "$description": "武陵青 · 自定义配色 · #14d0d0（不是最初要求的 #0daaaa：后者相对亮度仅 31.7%，在近黑页面上只有黄色的四成存在感）",
      "base": { "$value": "#14d0d0", "$type": "color", "$description": "相对亮度 49.8%。上限受制于亮色下与纸底的分离度：到 #16dcdc 只剩 1.39:1。" },
      "rgb": { "$value": "20, 208, 208", "$type": "string" },
      "hover": { "$value": "#10b8b8", "$type": "color", "$description": "按感知落差对齐黄色（ΔY 19.7 vs 19.9），不是照抄百分比。" },
      "onLight": { "$value": "#14d0d0", "$type": "color", "$description": "青色本身在墨色字下已经够深，无需单独的纸上档。" },
      "textLight": { "$value": "#006a6a", "$type": "color", "$description": "5.22 / 5.72。" },
      "textLightSoft": { "$value": "#003f3f", "$type": "color", "$description": "9.58 / 10.48。" },
      "textDark": { "$value": "#14d0d0", "$type": "color", "$description": "9.88 / 9.14。" },
      "textDarkSoft": { "$value": "#7ee7e7", "$type": "color", "$description": "暗色亮带：青色在这个亮度向下的余量更小，所以方向与黄色相反——提亮。13.04 / 12.06。" },
      "glowLight": { "$value": 0.08, "$type": "number" },
      "glowDark": { "$value": 0.04, "$type": "number", "$description": "比黄色更低：更亮的强调色把近黑页面抬得更快。" }
    }
  },

  "wash": {
    "$description": "一支强调色的五档淡层。alpha 不在明暗之间照抄：在近黑底上叠加亮度，比在纸底上减去亮度显得响得多。",
    "weak": { "$value": { "light": "rgba(var(--eds-accent-rgb), 0.12)", "dark": "rgba(var(--eds-accent-rgb), 0.14)" }, "$type": "color" },
    "hover": { "$value": { "light": "rgba(var(--eds-accent-rgb), 0.16)", "dark": "rgba(var(--eds-accent-rgb), 0.18)" }, "$type": "color" },
    "selected": { "$value": { "light": "rgba(var(--eds-accent-rgb), 0.22)", "dark": "rgba(var(--eds-accent-rgb), 0.20)" }, "$type": "color" },
    "active": { "$value": { "light": "rgba(var(--eds-accent-rgb), 0.26)", "dark": "rgba(var(--eds-accent-rgb), 0.28)" }, "$type": "color" },
    "edge": { "$value": "rgba(var(--eds-accent-rgb), 0.55)", "$type": "color", "$description": "2px 强调竖线，用于编辑风标题。" },
    "table": { "$value": "color-mix(in srgb, var(--eds-accent) 15%, var(--eds-surface-base))", "$type": "color", "$description": "表格行悬停：混进表面得到实色，而不是叠一层半透明——这样文字在它上面的对比度可以被真正量出来。" }
  },

  "decor": {
    "$description": "装饰守另一把尺子：可见但不抢眼。经验区间 1.06:1 ～ 1.6:1，低于 1.06 形同不存在。",
    "wordmarkAlpha": { "$value": { "light": 0.13, "dark": 0.085 }, "$type": "number", "$description": "纸底 1.310:1，近黑 1.215:1。暗色更低：加亮度比减亮度更响。" },
    "stroke": {
      "$value": { "light": "#beaf006b", "dark": "#fff50033" },
      "$type": "color",
      "$description": "谷地黄等高线。8 位 hex（#RRGGBBAA），因为 canvas 描边读不到 CSS 变量。合成后 1.290:1（亮）/ 1.734:1（暗）。"
    },
    "strokeAlt": {
      "$value": { "light": "#14d0d07a", "dark": "#14d0d045" },
      "$type": "color",
      "$description": "武陵青等高线。1.288:1（亮）/ 1.755:1（暗）——两套配色的合成对比度相差 ≤20%，alpha 是分别调参的，不是照抄。"
    },
    "gridLine": { "$value": "rgba(255, 255, 255, 0.014)", "$type": "color" },
    "gridRule": { "$value": "rgba(255, 255, 255, 0.010)", "$type": "color" },
    "gridPitch": { "$value": "120px", "$type": "dimension" }
  },

  "radius": {
    "none": { "$value": "0", "$type": "dimension", "$description": "默认。直角不是逐个组件改，而是先全部清零、再恢复该圆的。" },
    "pill": { "$value": "999px", "$type": "dimension", "$description": "只给天生是圆的形状：状态点、头像、加载圈、胶囊。与 corner-shape: round 同时使用。" }
  },

  "cornerShape": {
    "round": { "$value": "round", "$type": "string", "$description": "宿主把 corner-shape 根设在 superellipse(1.5) 时，999px 只会画出方圆形；每一个要画真圆的元素都必须重新钉住它。" }
  },

  "font": {
    "family": { "$value": "Arial, \"Helvetica Neue\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif", "$type": "fontFamily", "$description": "只施加在系统自有的节点上。绝不覆盖宿主的根字体令牌，也绝不在 body 上声明——两者都会泄漏进第三方挂件。" },
    "display": { "$value": "\"Arial Black\", Arial, \"PingFang SC\", \"Microsoft YaHei\", sans-serif", "$type": "fontFamily" },
    "condensed": { "$value": "\"Arial Narrow\", Arial, sans-serif", "$type": "fontFamily", "$description": "只用于一行需要压缩字宽的 tagline；缺失时自动退回 Arial 且仍然放得下。" },
    "figureFeatures": { "$value": "\"tnum\" 1, \"ss01\" 1", "$type": "string", "$description": "开在拥有数字的元素上，不是 body 级特性。" }
  },

  "typography": {
    "$description": "字号阶梯。display 与 wordmark 用 clamp 随视口缩放：取较小轴、给下限保可读、给上限防止大屏缩小。文字颜色在 text 组。",
    "size3xs": { "$value": "8px", "$type": "dimension" },
    "size2xs": { "$value": "9px", "$type": "dimension" },
    "sizeXs": { "$value": "10px", "$type": "dimension" },
    "sizeSm": { "$value": "11px", "$type": "dimension" },
    "sizeBase": { "$value": "12px", "$type": "dimension" },
    "sizeMd": { "$value": "13px", "$type": "dimension" },
    "sizeLg": { "$value": "14px", "$type": "dimension" },
    "sizeXl": { "$value": "17px", "$type": "dimension" },
    "size2xl": { "$value": "19px", "$type": "dimension" },
    "size3xl": { "$value": "22px", "$type": "dimension" },
    "size4xl": { "$value": "39px", "$type": "dimension", "$description": "启动读数。系统在静止状态下唯一「喊」的一处。" },
    "sizeDisplay": { "$value": "clamp(44px, 13vw, 176px)", "$type": "dimension" },
    "sizeWordmark": { "$value": "clamp(26px, min(5.2vh, 4.8vw), 64px)", "$type": "dimension" },
    "weightRegular": { "$value": 400, "$type": "number" },
    "weightMedium": { "$value": 500, "$type": "number" },
    "weightSemibold": { "$value": 600, "$type": "number" },
    "weightBold": { "$value": 700, "$type": "number" },
    "weightBlack": { "$value": 900, "$type": "number" },
    "trackingTight": { "$value": "-0.01em", "$type": "dimension", "$description": "只给大字号数字。" },
    "trackingLabel": { "$value": "0.02em", "$type": "dimension" },
    "trackingWide": { "$value": "0.06em", "$type": "dimension" },
    "trackingWider": { "$value": "0.10em", "$type": "dimension" },
    "trackingWidest": { "$value": "0.12em", "$type": "dimension" },
    "trackingMax": { "$value": "0.26em", "$type": "dimension", "$description": "技术标签。拉开字距 + 全大写是这套语言画「技术标签」的方式。" },
    "leadingNone": { "$value": 1, "$type": "number" },
    "leadingTight": { "$value": 0.8, "$type": "number", "$description": "堆叠字标行距：按墨迹间距算，不按 em 盒。" },
    "leadingNormal": { "$value": 1.5, "$type": "number" }
  },

  "motion": {
    "easeMorph": { "$value": "cubic-bezier(0.22, 0.72, 0.2, 1)", "$type": "cubicBezier", "$description": "形状变化。胶囊开合、高度与端盘半径同一条曲线。" },
    "easeSlam": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier", "$description": "入场砸落。" },
    "easeSweep": { "$value": "cubic-bezier(0.33, 1, 0.68, 1)", "$type": "cubicBezier" },
    "durMicro": { "$value": "120ms", "$type": "duration" },
    "durQuick": { "$value": "170ms", "$type": "duration" },
    "durBase": { "$value": "220ms", "$type": "duration" },
    "durSlow": { "$value": "300ms", "$type": "duration" },
    "durMorph": { "$value": "420ms", "$type": "duration" },
    "durWipe": { "$value": "520ms", "$type": "duration" },
    "durExit": { "$value": "620ms", "$type": "duration" },
    "durBoot": { "$value": "1750ms", "$type": "duration" },
    "durHold": { "$value": "3000ms", "$type": "duration" },
    "delayCrossfade": { "$value": "90ms", "$type": "duration", "$description": "交叉淡入的延迟：让品牌块先退到七成，数字再进来。" }
  },

  "elevation": {
    "$description": "纸是平的：系统几乎没有高程。有的只是层次，而最高两层是绝对值——它们必须赢过任何宿主 z-index。",
    "zBehind": { "$value": -1, "$type": "number", "$description": "水印：必须与父级的 isolation:isolate 同时使用，否则会逃到最近的祖先上下文、画进父级不透明底色后面。" },
    "zContent": { "$value": 0, "$type": "number", "$description": "外框内部的装饰层。" },
    "zHud": { "$value": 900, "$type": "number", "$description": "浮在页头上的胶囊。" },
    "zDialog": { "$value": 1000, "$type": "number" },
    "zCelebration": { "$value": 2147482000, "$type": "number" },
    "zBoot": { "$value": 2147483000, "$type": "number", "$description": "唯一有资格独占整屏的表面，所以大字必须低一档。" },
    "shadowCapsule": { "$value": "0 3px 10px rgba(0, 0, 0, 0.22)", "$type": "shadow" },
    "shadowBand": { "$value": "drop-shadow(0 10px 24px rgba(0, 0, 0, 0.35))", "$type": "shadow", "$description": "用 drop-shadow 而非 box-shadow：后者会包住整个盒子、浮在悬挂的胶囊下方。" }
  },

  "scrim": {
    "celebration": { "$value": "rgba(16, 17, 16, 0.55)", "$type": "color", "$description": "实测：0.55 是白色文字在两种亮色表面上都通过 AA 的第一档。0.28 在暗色好看，在亮色只有 2.29:1。" },
    "dialog": { "$value": "rgba(6, 6, 6, 0.62)", "$type": "color" },
    "dialogDark": { "$value": "rgba(0, 0, 0, 0.80)", "$type": "color", "$description": "暗色需要更重的遮罩：应用默认的黑 50% 压在 #101110 上，读起来是灰雾而不是黑场。" }
  },

  "material": {
    "$description": "有边界的磨砂。默认关闭，永不整窗。每提高一档同时提高不透明度与模糊，让强档更少地让背景动势干扰前景文字。",
    "fill": { "$value": { "light": "248 247 240", "dark": "31 36 34" }, "$type": "color" },
    "alpha": { "$value": { "subtle": 0.68, "standard": 0.80, "strong": 0.90 }, "$type": "number" },
    "blur": { "$value": { "subtle": "8px", "standard": "14px", "strong": "22px" }, "$type": "dimension" },
    "edge": { "$value": { "light": "rgb(255 255 255 / 0.65)", "dark": "rgb(255 255 255 / 0.18)" }, "$type": "color" },
    "sheen": { "$value": { "light": "rgb(255 255 255 / 0.35)", "dark": "rgb(255 255 255 / 0.07)" }, "$type": "color" }
  },

  "stadium": {
    "$description": "画出来的胶囊轮廓。999px 半径在宿主把 corner-shape 根设为 superellipse(1.5) 时只画出方圆形，所以轮廓由两个径向圆盘 + 中间色带拼成，盒子自身圆角为 0。",
    "capCollapsed": { "$value": "16px", "$type": "dimension", "$description": "必须等于高度的一半。" },
    "capHero": { "$value": "36px", "$type": "dimension" },
    "heightCollapsed": { "$value": "32px", "$type": "dimension", "$description": "参考胶囊是 448×48，按同一 9.3:1 比例压到 32px。" },
    "heightHero": { "$value": "72px", "$type": "dimension" },
    "fill": { "$value": "#312f30", "$type": "color", "$description": "接近黑但不是纯黑，比浮层沉一档。" }
  }
}
